{
  "name": "fullstack-rescript",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "res:build": "rescript build -with-deps",
    "res:watch": "rescript build -w -with-deps",
    "res:clean": "rescript clean -with-deps",
    "dev:backend": "bun run --cwd packages/backend dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "build": "bun run res:build && bun run --cwd packages/frontend build"
  },
  "devDependencies": {
    "rescript": "^12.0.0"
  }
}
