{
  "name": "fullstack-rescript",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "res:build": "rescript build",
    "res:clean": "rescript clean",
    "dev:backend": "bun run --cwd packages/backend dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "build": "bun run res:build && bun run --cwd packages/frontend build"
  },
  "devDependencies": {
    "rescript": "^12.0.0",
    "@rescript/react": "^0.13.0",
    "hono": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
